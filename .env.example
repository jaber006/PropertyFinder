# Domain.com.au API
DOMAIN_API_KEY=your_domain_api_key_here
DOMAIN_CLIENT_ID=your_client_id_here
DOMAIN_CLIENT_SECRET=your_client_secret_here

# Google Maps (optional - for distance calculations)
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Notifications (Clawdbot handles this via cron)
NOTIFY_WHATSAPP=true
